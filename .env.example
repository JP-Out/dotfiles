# Copie este arquivo para .env.local e preencha apenas no seu computador.
# Nunca versione .env.local.

# Caminho alternativo para este arquivo (usado por scripts que aceitam override).
DOTFILES_ENV=

# Dispositivo Bluetooth local. Formato esperado: XX:XX:XX:XX:XX:XX
MAC_ALEXA=

# Câmera RTSP. Prefira uma URL completa OU os campos separados, não ambos.
HYPR_RTSP_URL=
HYPR_RTSP_HOST=
HYPR_RTSP_USER=
HYPR_RTSP_PASSWORD=
HYPR_RTSP_PORT=554
HYPR_RTSP_PATH=stream1

# Nomes antigos ainda aceitos para compatibilidade com instalações existentes.
RTSP_STREAM_URL=
RTSP_HOST=
RTSP_USER=
RTSP_PASSWORD=
RTSP_PORT=
RTSP_PATH=
CAMERA_RTSP_URL=
IP_CAMERA=
CAMERA_IP=
CAMERA_HOST=
CAMERA_PASSWORD=

# Ajustes locais opcionais de sessão.
SWAYNC_FULLSCREEN_DND_POLL_INTERVAL=1
WHATSAPP_DEVTOOLS=0
WHATSAPP_START_HIDDEN=0
